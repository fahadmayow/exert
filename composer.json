{
  "name": "fahadmayow/exert",
  "description": "A lightweight Laravel package for implementing group-based action architecture.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Exert\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Exert\\ExertServiceProvider"
      ]
    }
  },
  "authors": [
    {
      "name": "Fahad Mayow",
      "email": "34403816+fahadmayow@users.noreply.github.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0 || ^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12.5"
  },
  "autoload-dev": {
    "psr-4": {
      "Exert\\Tests\\": "tests/"
    },
    "classmap": [
      "tests/Fixtures/"
    ]
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit"
  }
}
